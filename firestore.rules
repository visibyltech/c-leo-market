rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    // Admin access is tied to the exact administrator email and does not
    // depend on the email_verified claim.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'tvplugng@gmail.com';
    }
    function isOwner(userId) {
      return verifiedUser() && request.auth.uid == userId;
    }

    match /customers/{userId} {
      allow create: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['bvn','nin','bvnOrNin','password','role','isAdmin']);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['uid','role','isAdmin','bvn','nin','bvnOrNin','email']);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if verifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','paymentStatus','adminNote','updatedAt']);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /paySmallSmallPlans/{planId} {
      allow create: if verifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentStatus == 'pending';
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}